    <bpmn:sequenceFlow id="Flow_1nnejet" sourceRef="checkStore" targetRef="Gateway_1rl5hot" />
    <bpmn:serviceTask id="deleteStore" name="Delete Store" camunda:class="de.fraunhofer.isst.health.store.service.delete.DeleteStore">
      <bpmn:incoming>Flow_0qevgj7</bpmn:incoming>
      <bpmn:outgoing>Flow_03vibpt</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="checkStore" name="Check Store availability" camunda:class="de.fraunhofer.isst.health.store.service.delete.CheckStoreDeleted">
      <bpmn:incoming>Flow_0p8n7jv</bpmn:incoming>
      <bpmn:outgoing>Flow_1nnejet</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gateway_1rl5hot" name="Store deleted?">
      <bpmn:incoming>Flow_1nnejet</bpmn:incoming>
      <bpmn:outgoing>Flow_03fw2an</bpmn:outgoing>
      <bpmn:outgoing>Flow_02g1q9g</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="Flow_03fw2an" name="yes" sourceRef="Gateway_1rl5hot" targetRef="Event_0wfsak4">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${execution.getVariable('store-status')=='deleted'}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_02g1q9g" name="no" sourceRef="Gateway_1rl5hot" targetRef="Event_00c782b">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${execution.getVariable('store-status')!='deleted'}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
  </bpmn:process>
